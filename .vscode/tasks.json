{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build AT32F413 ELF",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/c",
                "make.bat"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build AT32F421 ELF",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/c",
                "make.bat",
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build STM32G431 ELF",
            "type": "shell",
            "command": "./make.bat",
            "options": {
                "env": {
                    "TARGET_CHIP": "stm32g431"
                }
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
