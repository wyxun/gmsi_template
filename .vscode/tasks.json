{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build ELF",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/c",
                "make.bat",
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
