{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "AT32F421 Debug (OpenOCD)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/template.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "D:/software/msys64/mingw64/bin/openocd-at32.exe",
            "searchDir": [
                "D:/software/msys64/mingw64/share/openocd/scripts"
            ],
            "configFiles": [
                "target/at32f421/openocd.cfg"
            ],
            "armToolchainPath": "D:/software/llvm_for_arm/bin",
            "toolchainPrefix": "llvm",
            "gdbPath": "D:/software/msys64/mingw64/bin/gdb-multiarch.exe",
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "label": "RTT Logs",
                        "port": 0,
                        "type": "console"
                    }
                ]
            },
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "svdFile": "${workspaceFolder}/target/at32f421/AT32F421xx_v2.svd",
            "preLaunchTask": "Build AT32F421 ELF"
        },
        {
            "name": "STM32G431 Debug (OpenOCD)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/template.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "D:/software/msys64/mingw64/bin/openocd.exe",
            "searchDir": [
                "D:/software/msys64/mingw64/share/openocd/scripts"
            ],
            "configFiles": [
                "target/stm32g431/openocd.cfg"
            ],
            "armToolchainPath": "D:/software/llvm_for_arm/bin",
            "toolchainPrefix": "llvm",
            "gdbPath": "D:/software/msys64/mingw64/bin/gdb-multiarch.exe",
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "label": "RTT Logs",
                        "port": 0,
                        "type": "console"
                    }
                ]
            },
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "preLaunchTask": "Build STM32G431 ELF"
        }
    ]
}